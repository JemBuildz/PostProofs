# APP_URL: Public base URL where PostProof is hosted (used for Stripe Checkout & Billing Portal return URLs).
APP_URL="http://localhost:3000"

# STRIPE_SECRET_KEY: Stripe TEST mode secret key (must start with sk_test_). Live keys are rejected.
STRIPE_SECRET_KEY=""

# STRIPE_WEBHOOK_SECRET: Stripe webhook signing secret (starts with whsec_, from Stripe CLI or Dashboard).
STRIPE_WEBHOOK_SECRET=""

# STRIPE_PRICE_ID_SOLO: Stripe Test Mode recurring Price ID for the Solo ($12/mo) plan (starts with price_).
STRIPE_PRICE_ID_SOLO=""

# STRIPE_PRICE_ID_STUDIO: Stripe Test Mode recurring Price ID for the Studio ($29/mo) plan (starts with price_).
STRIPE_PRICE_ID_STUDIO=""

# BILLING_STRICT_GATE: Optional ("true" to require an active paid Stripe subscription before creating any campaign; default "false" allows 1 starter campaign / 5 posts before requiring upgrade).
BILLING_STRICT_GATE="false"

# Firebase Admin credentials for non-GCP hosts (e.g. Netlify Functions).
# Leave empty locally when authenticated with `gcloud auth application-default login`.
# Using the compact pair keeps Netlify's ~4 KB combined env var quota small.
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""
